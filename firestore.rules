rules_version = '2';
// Deeva Orders — who can see and change what.
//  admin   : Mayuresh — everything (all stores, approve, edit, team, price, payments, dashboard, activity)
//  subadmin: Darshana — same as admin (approvals are mainly hers), but cannot change an admin's account
//  store   : one manager per store — creates orders for HIS store only, sees only his store's orders,
//            client + price + payments of those orders, edits until approved, replies to queries,
//            CAD decision, date / priority change, marks received / delivered
//  factory : only approved orders (factoryVisible), only product details (no client, no price),
//            updates stage, dispatches
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUser() { return signedIn() && exists(userDoc()); }
    function me() { return get(userDoc()).data; }
    function active() { return hasUser() && me().active == true; }
    function isOwner() { return active() && me().role == 'admin'; }
    function isAdmin() { return active() && me().role in ['admin', 'subadmin']; }
    function isStore() { return active() && me().role == 'store' && me().get('storeId', '') != ''; }
    function isFactory() { return active() && me().role == 'factory'; }
    function staff() { return isAdmin() || isStore(); }
    function myStore() { return me().get('storeId', ''); }

    // first setup: the first person becomes admin, only once
    match /config/admin {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(userDoc()).data.role == 'admin';
      allow update, delete: if false;
    }
    // config/brand: Deeva signature on receipts
    match /config/{doc} {
      allow read: if active();
      allow write: if isAdmin() && doc != 'admin';
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read: if active();
      allow create: if isOwner()
        || (isAdmin() && request.resource.data.role != 'admin')
        || (signedIn() && uid == request.auth.uid
            && !exists(/databases/$(database)/documents/config/admin)
            && getAfter(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid
            && request.resource.data.role == 'admin' && request.resource.data.active == true);
      allow update: if isOwner()
        || (isAdmin() && resource.data.role != 'admin' && request.resource.data.role != 'admin')
        || (active() && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['micLang']));
      allow delete: if false;
    }

    match /stores/{sid} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Login ID -> sign-in email (looked up before login)
    match /logins/{id} {
      allow get: if true;
      allow list, create: if isAdmin();
      allow update, delete: if isOwner()
        || (isAdmin() && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.role != 'admin');
    }

    // phones / browsers registered for notifications (read only by the notification server)
    match /pushTokens/{token} {
      allow create, update: if active() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow read: if false;
    }

    // monthly order-number counters (DD-YYMM-001 ...)
    match /counters/{ym} {
      allow read: if staff();
      allow create: if staff() && request.resource.data.n == 1;
      allow update: if staff() && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    function sameIdentity() {
      let o = resource.data; let n = request.resource.data;
      return n.no == o.no && n.seq == o.seq && n.ym == o.ym && n.createdBy == o.createdBy && n.storeId == o.storeId;
    }

    function storeUpdate() {
      let o = resource.data; let n = request.resource.data;
      let k = n.diff(o).affectedKeys();
      return o.storeId == myStore() && sameIdentity() && n.factoryVisible == o.factoryVisible && (
        // before approval: may correct details and answer a query
        (o.status in ['review', 'query']
          && (n.status == o.status || (o.status == 'query' && n.status == 'review'))
          && !k.hasAny(['approvedAt', 'approvedBy', 'factoryDue', 'factoryNote', 'stage', 'stageAt',
                        'dispatch', 'cadRequired', 'cad', 'factoryAck', 'factoryAckAt', 'cancel']))
        ||
        // after approval: notes/photos, CAD decision, date/priority, received at store, delivered
        (o.status in ['factory', 'dispatched', 'received']
          && k.hasOnly(['log', 'media', 'updatedAt', 'updatedBy', 'stage', 'stageAt', 'cad', 'status', 'received',
                        'delivered', 'deliveryDay', 'priority', 'factoryAck'])
          && (n.stage == o.stage || (o.stage == 'cad_approval' && n.stage in ['cad', 'casting']))
          && (n.status == o.status
              || (o.status == 'dispatched' && n.status in ['received', 'delivered'])
              || (o.status == 'received' && n.status == 'delivered')))
      );
    }

    function factoryUpdate() {
      let o = resource.data; let n = request.resource.data;
      let k = n.diff(o).affectedKeys();
      let cadOk = !(o.get('cadRequired', false) == true && o.get('cad', {}).get('ok', false) != true);
      return sameIdentity()
        && o.factoryVisible == true && n.factoryVisible == true
        && o.status in ['factory', 'dispatched']
        && k.hasOnly(['stage', 'stageAt', 'log', 'media', 'updatedAt', 'updatedBy', 'dispatch', 'status', 'factoryAck', 'factoryAckAt'])
        && (n.status == o.status || (o.status == 'factory' && n.status == 'dispatched'))
        && n.stage in ['new', 'received', 'cad', 'cad_approval', 'casting', 'filing', 'setting', 'polish', 'qc', 'ready', 'dispatched']
        && (n.stage == o.stage || cadOk || n.stage in ['new', 'received', 'cad', 'cad_approval']);
    }

    match /orders/{id} {
      allow read: if isAdmin()
        || (isStore() && resource.data.storeId == myStore())
        || (isFactory() && resource.data.factoryVisible == true);
      allow create: if staff()
        && (isAdmin() || request.resource.data.storeId == myStore())
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && request.resource.data.status == 'review'
        && request.resource.data.factoryVisible == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.seq is int
        && getAfter(/databases/$(database)/documents/counters/$(request.resource.data.ym)).data.n == request.resource.data.seq;
      allow update: if isAdmin() || (isStore() && storeUpdate()) || (isFactory() && factoryUpdate());
      allow delete: if false;

      // client name/phone, price, payments, signature, internal notes & receipts — never visible to the factory
      match /private/{doc} {
        allow read: if isAdmin() || (isStore() && resource.data.storeId == myStore());
        allow create: if isAdmin() || (isStore() && request.resource.data.storeId == myStore());
        allow update: if isAdmin()
          || (isStore() && resource.data.storeId == myStore() && request.resource.data.storeId == resource.data.storeId);
        allow delete: if false;
      }
    }

    // admin dashboard reads every order's private doc in one query
    match /{path=**}/private/{doc} {
      allow read: if isAdmin();
    }
  }
}
